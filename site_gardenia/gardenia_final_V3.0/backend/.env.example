# Connection String do seu MongoDB Atlas ou MongoDB local
# Exemplo Atlas: mongodb+srv://usuario:senha@cluster0.xxxxx.mongodb.net/
# Exemplo Local: mongodb://localhost:27017/
MONGODB_URI=mongodb+srv://coloque-aqui-sua-connection-string

# Nome do banco de dados
MONGODB_DB=gardenia_modas

# Chave secreta de sessão do Flask
SECRET_KEY=gardenia-dev-chave-secreta-altere-aqui
